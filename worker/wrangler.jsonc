{
  "name": "timeline-issue-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [{ "name": "OAUTH_STATE", "class_name": "OAuthState" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OAuthState"] }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SITE_ORIGIN": "https://timeline-project-sc2.github.io"
    // Приватная цель и App задаются в Cloudflare после подтверждения владельца:
    //   PROPERTY_REPOSITORY_ID, PROPERTY_REPOSITORY (не публичный сайт),
    //   GITHUB_APP_CLIENT_ID, GITHUB_APP_INSTALLATION_ID,
    //   PROPERTY_OPEN_LIMIT (1–20; без значения приём выключен),
    //   GITHUB_CLIENT_ID, GITHUB_CALLBACK_URL.
    // Секреты только через wrangler secret put, не в этом файле:
    //   GITHUB_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY.
  }
  // Развёртывание, живая Issue, применение и публикация — HOLD.
}
