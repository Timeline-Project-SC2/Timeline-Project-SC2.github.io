{
  "name": "timeline-project-sc2-site",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview --port 8080 --host",
    "dev": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "check:fast": "node tools/check_fast.mjs",
    "lint": "eslint site src tools tests",
    "test": "node --test tests/*.test.mjs tests/*.test.js",
    "test:sector-admin-edit": "node --test tests/sector-admin-edit.test.mjs",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:all": "npm test && npm run test:py",
    "build:planet-core": "node tools/build_planet_core.mjs",
    "check:planet-core": "node tools/build_planet_core.mjs --check",
    "verify:contract": "node tools/verify_planet_contract_cross.mjs",
    "verify:address": "node tools/verify_sector_address.mjs",
    "verify:sector-core": "node tools/verify_sector_core.mjs",
    "verify:no-raster": "node tools/verify_no_raster.mjs",
    "sector-field:preview": "node tools/sector_field_preview.mjs",
    "verify:publish": "node tools/verify_feature_parity.mjs",
    "verify:hashes": "node tools/verify_planet_hashes.mjs",
    "verify:docs": "python3 tools/check_docs.py",
    "assets:build": "python3 tools/build_assets.py",
    "assets:check": "python3 tools/build_assets.py --check",
    "assets:sync-only": "python3 tools/build_assets.py --sync-only",
    "test:fast": "node tools/test_fast.mjs",
    "context": "node tools/context.mjs",
    "audit:bounds-edit": "node tools/audit_bounds_edit.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "assemblyscript": "0.28.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "miniflare": "^4.20260730.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5"
  }
}
